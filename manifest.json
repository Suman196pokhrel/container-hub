{
  "schemaVersion": 1,
  "id": "io.github.suman196pokhrel.container-hub",
  "name": "Container Hub",
  "version": "0.2.1",
  "author": "Suman Pokhrel",
  "license": "MIT",
  "description": "Monitor and manage local Docker containers from the Omarchy bar: view status, ports, and logs; start, stop, or remove containers without leaving your desktop.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Panel.qml" },
  "barWidget": {
    "displayName": "Container Hub",
    "description": "Monitor and manage local Docker containers.",
    "category": "Developer",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalOpenSec": 3,
      "refreshIntervalClosedSec": 15,
      "logTailLines": 200
    },
    "schema": [
      {
        "key": "refreshIntervalOpenSec",
        "type": "integer",
        "label": "Refresh interval while open (seconds)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "refreshIntervalClosedSec",
        "type": "integer",
        "label": "Refresh interval while closed (seconds)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "logTailLines",
        "type": "integer",
        "label": "Log lines to fetch",
        "min": 50,
        "max": 1000,
        "step": 50,
        "defaultValue": 200
      }
    ]
  }
}
